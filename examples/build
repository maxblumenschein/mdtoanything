#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

# Make resources/ visible to the TeX engine for \input{user_variables_definition}
export TEXINPUTS="$SCRIPT_DIR/resources:$TEXINPUTS"

# Link fonts activated by a font manager and set OSFONTDIR, as pandoc_convert does
. "$SCRIPT_DIR/../script/pandoc_convert.sh"

# When pandoc-crossref and citeproc are both needed, run them in two separate
# passes to avoid citeproc failing to resolve in-footnote citations.
# Pass 1: pandoc-crossref (JSON); Pass 2: citeproc + template + pdf-engine.
# pandoc-crossref runs in pipe mode, told the target format (latex): as a filter
# of the JSON pass it would number captions and references itself ("Figure 1:").

# LINEAR
pandoc "text_example.md" \
  -t json \
  --resource-path=".:resources" |
  pandoc-crossref --pipe latex > /tmp/_linear_crossref.json

pandoc /tmp/_linear_crossref.json \
  -f json \
  -o "output/linear_example.pdf" \
  --template="../latex templates/linear.latex" \
  --pdf-engine="lualatex" \
  --citeproc \
  --standalone \
  --resource-path=".:resources"

# LINEAR-TUFTE
pandoc "text_example.md" \
  -t json \
  --resource-path=".:resources" |
  pandoc-crossref --pipe latex > /tmp/_linear-tufte_crossref.json

pandoc /tmp/_linear-tufte_crossref.json \
  -f json \
  -o "output/linear-tufte_example.pdf" \
  --template="../latex templates/linear-tufte.latex" \
  --pdf-engine="lualatex" \
  --citeproc \
  --standalone \
  --resource-path=".:resources"

# INFO
pandoc "text_example.md" \
  -t json \
  --resource-path=".:resources" |
  pandoc-crossref --pipe latex > /tmp/_info_crossref.json

pandoc /tmp/_info_crossref.json \
  -f json \
  -o "output/info_example.pdf" \
  --template="../latex templates/info.latex" \
  --pdf-engine="lualatex" \
  --citeproc \
  --standalone \
  --resource-path=".:resources"

# LABEL
pandoc "label_example.md" \
-o "output/label_example.pdf" \
--template="../latex templates/label.latex" \
--pdf-engine="lualatex" \
--standalone \
--resource-path=".:resources"

# LABEL TECHNICAL
pandoc "label_example.md" \
-o "output/label_technical_example.pdf" \
--template="../latex templates/label_technical.latex" \
--pdf-engine="lualatex" \
--standalone \
--resource-path=".:resources"

# LETTER -> Execute the Pandoc command
pandoc "letter_example.md" \
-o "output/letter_example.pdf" \
--template="../latex templates/letter.latex" \
--pdf-engine="lualatex" \
--citeproc \
--standalone \
--resource-path=".:resources"

# LETTER-INVOICE -> Execute the Pandoc command
pandoc "invoice_example.md" \
-o "output/letter-invoice_example.pdf" \
--template="../latex templates/letter.latex" \
--pdf-engine="lualatex" \
--citeproc \
--standalone \
--resource-path=".:resources"

# LETTER-CV -> Execute the Pandoc command
pandoc "cv_example.md" \
-o "output/letter-cv_example.pdf" \
--template="../latex templates/letter.latex" \
--pdf-engine="lualatex" \
--citeproc \
--standalone \
--resource-path=".:resources"
