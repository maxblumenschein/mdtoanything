% font: Söhne %
\AtBeginDocument{\fontsize{10pt}{11pt}\selectfont}

\setmainfont[
  ItalicFont = Söhne-BuchKursiv.ttf,
  BoldFont = Söhne-Kräftig.ttf,
  BoldItalicFont = Söhne-KräftigKursiv.ttf
]{Söhne-Buch.ttf}

