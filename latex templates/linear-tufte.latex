% list of figures %
\renewcommand\cftloftitlefont{\listtitlefont}
% unböld figure caption %
\renewcommand\cftfigfont{\mdseries}
% unböld figure folios %
\renewcommand\cftfigpagefont{\mdseries\liningnumbers}

% list of tables %
\renewcommand\cftlottitlefont{\listtitlefont}
% unböld table caption %
\renewcommand\cfttabfont{\mdseries}
% unböld table folios %
\renewcommand\cfttabpagefont{\mdseries\liningnumbers}


% blockquotes %
\AtBeginEnvironment{quote}{\small}

\renewenvironment{quote}{%
  \list{}{%
    \leftmargin2em   % this is the adjusting screw
    \rightmargin2em
    \setstretch{1.1}
  }
  \item\relax
}
{\endlist}
 \AtBeginEnvironment{quote}{\par
 %\itshape%  % italic blockquotes
 }

% lists %
\setlist{leftmargin=2em}

% sidenotes & margin notes %
% footnotes become numbered sidenotes in the margin column, \marginnote{…} sets an unnumbered note
\setlength{\marginparpush}{7pt} % spacing between notes
\makeatletter
% style of all text in the margin column
\newcommand\marginstyle{\normalfont\footnotesize\setstretch{1.1}\RaggedRight\parindent\z@\parskip\z@}
% note number in the text and in the margin
\newcommand\sidenotemark[1]{\textsuperscript{\liningnumbers#1}}

% \marginpar only works in the main text; floats, minipages, parboxes and table cells use marginnote
\newif\ifmdtoa@outerpar \mdtoa@outerpartrue
\appto\@parboxrestore{\mdtoa@outerparfalse}
\appto\@arrayparboxrestore{\mdtoa@outerparfalse}
\renewcommand*{\raggedrightmarginnote}{}
\NewCommandCopy\mdtoa@marginnote\marginnote
\newcommand\mdtoa@margin[1]{%
  \@tempswatrue
  \ifinner\@tempswafalse\fi
  \ifmdtoa@outerpar\else\@tempswafalse\fi
  \ifdefined\@captype\@tempswafalse\fi
  \if@tempswa
    \marginpar{\marginstyle#1}%
  \else
    % marginnote puts notes in the left margin of even pages, the margin column is always on the right
    \begingroup\@twosidefalse\mdtoa@marginnote{\marginstyle#1}[\z@]\endgroup
  \fi}
% notes start with a strut, so their first baseline aligns with the line of the reference
\newcommand\mdtoa@sidenote[2]{\mdtoa@margin{\strut\sidenotemark{#1}\hspace{.3em}\ignorespaces#2}}

\NewDocumentCommand\mdtoa@footnote{o +m}{%
  \IfNoValueTF{#1}
    {\stepcounter{footnote}\protected@edef\mdtoa@num{\thefootnote}}
    {\begingroup\c@footnote=#1\relax\protected@xdef\mdtoa@num{\thefootnote}\endgroup}%
  \sidenotemark{\mdtoa@num}%
  \expandafter\mdtoa@sidenote\expandafter{\mdtoa@num}{#2}}
% headings: the mark is set in the heading, the note after it (titlesec's \footnote would set it below the heading space)
\let\mdtoa@headingnotelist\@empty
\NewDocumentCommand\mdtoa@headingfootnote{o +m}{%
  \IfNoValueTF{#1}
    {\stepcounter{footnote}\protected@edef\mdtoa@num{\thefootnote}}
    {\begingroup\c@footnote=#1\relax\protected@xdef\mdtoa@num{\thefootnote}\endgroup}%
  \sidenotemark{\mdtoa@num}%
  \protected@xdef\mdtoa@headingnotelist{%
    \unexpanded\expandafter{\mdtoa@headingnotelist}%
    \noexpand\mdtoa@headingnote{\mdtoa@num}{\unexpanded{#2}}}}
\newcommand\mdtoa@headingnotes{\let\footnote\mdtoa@headingfootnote}
% in vertical mode after the heading, raised by the depth of its last line and the strut of the note
\newcommand\mdtoa@headingnote[2]{%
  \sbox\z@{\marginstyle\strut}%
  \ifdim\prevdepth<\z@
    \mparshift{-\ht\z@}%
  \else
    \mparshift{-\dimexpr\prevdepth+\ht\z@\relax}%
  \fi
  \mdtoa@sidenote{#1}{#2}}
\newcommand\mdtoa@flushheadingnotes{%
  \mdtoa@headingnotelist
  \global\let\mdtoa@headingnotelist\@empty}
% defined at the begin of the document, after packages have set up their footnotes
\newcommand\mdtoa@setupnotes{%
  \let\footnote\mdtoa@footnote
  \RenewDocumentCommand\footnotemark{o}{%
    \IfNoValueTF{##1}
      {\stepcounter{footnote}\sidenotemark{\thefootnote}}
      {\begingroup\c@footnote=##1\relax\sidenotemark{\thefootnote}\endgroup}}%
  \RenewDocumentCommand\footnotetext{o +m}{%
    \IfNoValueTF{##1}
      {\protected@edef\mdtoa@num{\thefootnote}}
      {\begingroup\c@footnote=##1\relax\protected@xdef\mdtoa@num{\thefootnote}\endgroup}%
    \ifvmode\if@noskipsec
      % note of a run-in heading: set it in the paragraph that starts with the heading
      \protected@edef\mdtoa@tempa{%
        \noexpand\AddToHookNext{para/begin}{\noexpand\mdtoa@sidenote{\mdtoa@num}{\unexpanded{##2}}}}%
      \mdtoa@tempa
    \else
      \expandafter\mdtoa@sidenote\expandafter{\mdtoa@num}{##2}%
    \fi\else
      \expandafter\mdtoa@sidenote\expandafter{\mdtoa@num}{##2}%
    \fi}%
  % \marginnote{text} or \marginnote[offset]{text}, an offset turns off the collision avoidance
  \RenewDocumentCommand\marginnote{o +m}{%
    \IfNoValueTF{##1}
      {\mdtoa@margin{\strut\ignorespaces##2}}
      {\begingroup\@twosidefalse\mdtoa@marginnote{\marginstyle##2}[##1]\endgroup}}}
\AtBeginDocument{\mdtoa@setupnotes}

% new thought: opening words in small caps, letterspaced capitals if the font has no small caps
\ExplSyntaxOn
\NewDocumentCommand\newthought{m}{
  \par\addvspace{\baselineskip}\noindent
  \fontspec_if_feature:nTF {smcp}
    {{\scshape\addfontfeature{LetterSpace=5}#1}}
    {{\footnotesize\addfontfeature{LetterSpace=10}\MakeUppercase{#1}}}
}
\ExplSyntaxOff

% full width: text, tables and figures across text and margin column
\newif\ifmdtoa@fullwidth
\newenvironment{fullwidth}{%
  \par
  \blockmargin % keeps margin notes out of the full width
  \hsize\dimexpr\columnwidth+\marginparsep+\marginparwidth\relax
  \linewidth\hsize
  \mdtoa@fullwidthtrue
  \mdtoa@margincaptionsfalse}
  {\par\unblockmargin}
% floats reset their width to the text column
\newcommand\mdtoa@fullwidthfloat{%
  \ifmdtoa@fullwidth
    \hsize\dimexpr\columnwidth+\marginparsep+\marginparwidth\relax
    \linewidth\hsize
  \fi}
\AtBeginDocument{\appto\@floatboxreset{\mdtoa@fullwidthfloat}}

% figures & tables in the margin column, a figure environment inside sets its contents in place
% the top aligns with the capitals of the text line
\newlength\mdtoa@capheight
\newcommand\mdtoa@marginfloat[2]{% #1 figure or table, #2 contents
  \mdtoa@capheight=\fontcharht\font`H\relax
  \mdtoa@margin{%
    \vskip-\mdtoa@capheight
    \def\@captype{#1}%
    \renewenvironment{#1}[1][]{}{}%
    \mdtoa@margincaptionsfalse
    \captionsetup{hypcap=false}%
    #2}}
\NewDocumentEnvironment{marginfigure}{+b}{\mdtoa@marginfloat{figure}{#1}}{}
\NewDocumentEnvironment{margintable}{+b}{\mdtoa@marginfloat{table}{#1}}{}

% figure captions in the margin column, the last line aligned with the bottom of the figure
\newif\ifmdtoa@margincaptions \mdtoa@margincaptionstrue
\newlength\mdtoa@captionraise
\newsavebox\mdtoa@captionbox
\let\mdtoa@captionargs\relax
\newcommand\mdtoa@figurebegin{%
  \let\centering\relax % figures flush left
  \ifmdtoa@margincaptions
    \DeclareCommandCopy\mdtoa@caption\caption
    \DeclareCommandCopy\mdtoa@label\label
    \let\mdtoa@captionlabels\@empty
    % store the caption and the labels following it, set them at the end of the figure
    \RenewDocumentCommand\caption{o +m}{%
      \par % ends the paragraph of the figure, as \caption does
      \IfNoValueTF{##1}
        {\def\mdtoa@captionargs{\mdtoa@caption{##2}}}
        {\def\mdtoa@captionargs{\mdtoa@caption[##1]{##2}}}%
      \RenewDocumentCommand\label{m}{\appto\mdtoa@captionlabels{\mdtoa@label{####1}}}}%
  \fi}
\newcommand\mdtoa@figureend{%
  \ifx\mdtoa@captionargs\relax\else
    \par
    % baseline of the last line of the figure
    \mdtoa@captionraise=\prevdepth
    \ifdim\mdtoa@captionraise<\z@ \mdtoa@captionraise=\z@\fi
    % caption box with the baseline of its last line at the bottom, takes no space
    \sbox\mdtoa@captionbox{\parbox[b]{\marginparwidth}{%
      \captionsetup{position=below,skip=\z@}%
      \mdtoa@captionargs\mdtoa@captionlabels\par
      \ifdim\prevdepth>\z@\vskip-\prevdepth\fi}}%
    % figures placed here [H] keep margin notes out of the caption, see \mdtoa@figureafter
    \ifx\@currbox\float@box
      \xdef\mdtoa@captionspace{\the\dimexpr\ht\mdtoa@captionbox+\mdtoa@captionraise\relax}%
    \fi
    \ht\mdtoa@captionbox\z@ \dp\mdtoa@captionbox\z@
    \nointerlineskip
    \hbox to\z@{%
      \hskip\dimexpr\linewidth+\marginparsep\relax
      \raise\mdtoa@captionraise\box\mdtoa@captionbox
      \hss}%
  \fi}
% directly after the box of a [H] figure, reserve the caption's space in the margin
\newcommand\mdtoa@figureafter{%
  \ifx\mdtoa@captionspace\relax\else
    \marginphantom[-\mdtoa@captionspace]{\mdtoa@captionspace}%
    \global\let\mdtoa@captionspace\relax
  \fi}
\let\mdtoa@captionspace\relax
\AtBeginDocument{%
  \ifdefined\float@endH
    \patchcmd{\float@endH}{\box\@currbox}{\box\@currbox\mdtoa@figureafter}{}%
      {\@latex@warning@no@line{linear-tufte: margin notes may overlap figure captions}}%
  \fi}
\AtBeginEnvironment{figure}{\mdtoa@figurebegin}
\AtEndEnvironment{figure}{\mdtoa@figureend}
\makeatother

% images %
$if(graphics)$
\usepackage{graphicx}
\makeatletter
\newsavebox\pandoc@box
\newcommand*\pandocbounded[1]{% scales image to fit in text height/width
  \sbox\pandoc@box{#1}%
  \Gscale@div\@tempa{\textheight}{\dimexpr\ht\pandoc@box+\dp\pandoc@box\relax}%
  \Gscale@div\@tempb{\linewidth}{\wd\pandoc@box}%
  \ifdim\@tempb\p@<\@tempa\p@\let\@tempa\@tempb\fi% select the smaller of both
  \ifdim\@tempa\p@<\p@\scalebox{\@tempa}{\usebox\pandoc@box}%
  \else\usebox{\pandoc@box}%
  \fi%
}
% Set default figure placement to htbp
% Make use of float-package and set default placement for figures to H.
% The option H means 'PUT IT HERE' (as  opposed to the standard h option which means 'You may put it here if you like').
\usepackage{float}
\floatplacement{figure}{$if(float-placement-figure)$$float-placement-figure$$else$H$endif$}
\makeatother
$endif$

% lists %
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% leftaligned captions
\captionsetup{justification   = RaggedRight,
              singlelinecheck = false,
              font={rm,up,md,footnotesize,stretch=1.1}}

% bibliography style %
$if(csl-refs)$
% definitions for citeproc citations
\NewDocumentCommand\citeproctext{}{}
\NewDocumentCommand\citeproc{mm}{%
\begingroup\def\citeproctext{#2}\cite{#1}\endgroup}
\makeatletter
% allow citations to break across lines
\let\@cite@ofmt\@firstofone
% avoid brackets around text for \cite:
\def\@biblabel#1{}
\def\@cite#1#2{{#1\if@tempswa , #2\fi}}
\makeatother
\newlength{\cslhangindent}
\setlength{\cslhangindent}{1.5em}
\newlength{\csllabelwidth}
\setlength{\csllabelwidth}{3em}
\newenvironment{CSLReferences}[2] % #1 hanging-indent, #2 entry-spacing
{\raggedright\begin{list}{}{%
	\setlength{\itemindent}{0pt}
	\setlength{\leftmargin}{0pt}
	\setlength{\parsep}{0pt}
	% turn on hanging indent if param 1 is 1
	\ifodd #1
	\setlength{\leftmargin}{\cslhangindent}
	\setlength{\itemindent}{-1\cslhangindent}
	\fi
	% set entry spacing
	\setlength{\itemsep}{#2\baselineskip}}}
{\end{list}}
\usepackage{calc}
\newcommand{\CSLBlock}[1]{\hfill\break\parbox[t]{\linewidth}{\strut\ignorespaces#1\strut}}
\newcommand{\CSLLeftMargin}[1]{\parbox[t]{\csllabelwidth}{\strut#1\strut}}
\newcommand{\CSLRightInline}[1]{\parbox[t]{\linewidth - \csllabelwidth}{\strut#1\strut}}
\newcommand{\CSLIndent}[1]{\hspace{\cslhangindent}#1}
$endif$

\urlstyle{same}

\raggedbottom % prevents \flushbottom when using twoside option

%----------%
% document %
\begin{document}

$if(title)$
\maketitle
\thispagestyle{empty}
$endif$

\ifbool{isreport}{
$if(abstract)$
\chapter*{Abstract}
    \begin{abstract}
    $abstract$
    \end{abstract}
$endif$
}{}

\ifbool{isarticle}{
$if(abstract)$
\section*{Abstract}
    \begin{abstract}
    $abstract$
    \end{abstract}
$endif$
}{}

\ifbool{isbook}{
$if(abstract)$
\chapter*{Abstract}
  $abstract$
$endif$
}{}

\ifbool{isreport}{\pagebreak}{}
\ifbool{isarticle}{
$if(titlepage)$
\pagebreak
$endif$
}{}

$if(toc)$
\tableofcontents
$endif$

$body$

\ifbool{isreport}{
$if(lof)$
\addcontentsline{toc}{chapter}{\listfigurename}
\listoffigures
$endif$
}{}

\ifbool{isarticle}{
$if(lof)$
\addcontentsline{toc}{section}{\listfigurename}
\listoffigures
$endif$
}{}

\ifbool{isbook}{
$if(lof)$
\addcontentsline{toc}{section}{\listfigurename}
\listoffigures
$endif$
}{}

\ifbool{isreport}{
$if(lot)$
\addcontentsline{toc}{chapter}{\listtablename}
\listoftables
$endif$
}{}

\ifbool{isarticle}{
$if(lot)$
\addcontentsline{toc}{section}{\listtablename}
\listoftables
$endif$
}{}

\ifbool{isbook}{
$if(lot)$
