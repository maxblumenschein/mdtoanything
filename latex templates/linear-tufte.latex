% page layout %
% text column with a wide margin column on the right (tufte-latex a4 proportions)
\geometry{
top=43.3353571543mm, %297mm/1.618^4
bottom=43.3353571543mm,
left=24.8mm,
textwidth=107mm,
marginparsep=8.2mm,
marginparwidth=49.4mm, %24.8mm+107mm+8.2mm+49.4mm leaves 20.6mm on the right
asymmetric, % margin column on the right of every page, also with twoside
}

% custom fonts set %
\setstretch{1.1}
\setmainfont[
%Path = \fontpath,
LetterSpace = 0.3,
Numbers = OldStyle,
ItalicFont = BradfordLL-RegularItalic.otf,
BoldFont = BradfordLL-Bold.otf,
BoldItalicFont  = BradfordLL-BoldItalic.otf]
{BradfordLL-Regular.otf}

\setmonofont[
%Path = \fontpath,
Scale       = MatchLowercase ,
ItalicFont = BradfordMonoLL-Regular.otf,
BoldFont = BradfordMonoLL-Regular.otf,
BoldItalicFont  = BradfordMonoLL-Regular.otf]
{BradfordMonoLL-Regular.otf}

%lining-numbers command for occasional use
\newcommand\liningnumbers{\addfontfeature{Numbers={Lining,Monospaced}}}

%lining tabular figures in tables %
\AtBeginEnvironment{tabular}{\small\addfontfeature{Numbers={Lining,Monospaced}}}
\AtBeginEnvironment{tabular*}{\small\addfontfeature{Numbers={Lining,Monospaced}}}
\AtBeginEnvironment{longtable}{\small\addfontfeature{Numbers={Lining,Monospaced}}}


% define isreport boolean which may be used inside the document contrary to ifclassloaded
\providebool{isreport}
\makeatletter
\@ifclassloaded{report}{\booltrue{isreport}}{\boolfalse{isreport}}
\makeatother

% define isarticle boolean which may be used inside the document contrary to ifclassloaded
\providebool{isarticle}
\makeatletter
\@ifclassloaded{article}{\booltrue{isarticle}}{\boolfalse{isarticle}}
\makeatother

% define isarticle boolean which may be used inside the document contrary to ifclassloaded
\providebool{isbook}
\makeatletter
\@ifclassloaded{book}{\booltrue{isbook}}{\boolfalse{isbook}}
\makeatother

% body %
\setlength{\emergencystretch}{3em} %parameter for justification
\setlength{\parindent}{2em}
% ragged-right text, paragraphs keep their indent
\setlength{\RaggedRightParindent}{\parindent}
\AtBeginDocument{\RaggedRight}

% numbering of headings, off by default
\setcounter{secnumdepth}{$if(numdepth)$$numdepth$$else$-1$endif$}

% unnumbered chapters don't step the chapter counter, number figures, tables and equations continuously
\ifdefined\chapter
\ifnum\value{secnumdepth}<0
\counterwithout{figure}{chapter}
\counterwithout{table}{chapter}
\counterwithout{equation}{chapter}
\fi
\fi

% custom title & heading fonts: Bradford italic, no bold
% notes in headings are set beside the last line of the heading (\mdtoa@headingnotes, see sidenotes)
\makeatletter
\ifdefined\chapter
\titleformat{\chapter}[hang]{\mdtoa@headingnotes\raggedright\setstretch{1.0}\Huge\itshape}{\thechapter}{.5em}{}[\mdtoa@flushheadingnotes]
\fi
\titleformat{\section}[hang]{\mdtoa@headingnotes\raggedright\setstretch{1.0}\Large\itshape}{\thesection}{.5em}{}[\mdtoa@flushheadingnotes]
\titleformat{\subsection}[hang]{\mdtoa@headingnotes\raggedright\setstretch{1.0}\large\itshape}{\thesubsection}{.5em}{}[\mdtoa@flushheadingnotes]
\titleformat{\subsubsection}[hang]{\mdtoa@headingnotes\raggedright\normalsize\itshape}{\thesubsubsection}{.5em}{}[\mdtoa@flushheadingnotes]
% run-in headings: titlesec sets their notes after the heading, in the same line
\titleformat{\paragraph}[runin]{\normalsize\itshape}{\theparagraph}{.5em}{}
\titleformat{\subparagraph}[runin]{\normalsize\itshape}{\thesubparagraph}{.5em}{}
\makeatother

% title &
% patch \maketitle so that it doesn't center
\makeatletter
\renewcommand{\maketitle}{%
  $if(titlepage)$%
  \vspace*{\droptitle}%
  \begin{flushleft}%
    \setstretch{1.0}\Huge\itshape\@title\par%
  \end{flushleft}%
  $if(twoside)$\null\thispagestyle{empty}\newpage$endif$%
  \null\thispagestyle{empty}\newpage%
  \vspace*{\droptitle}%
  {\parindent\z@\raggedright%
  \setstretch{1.0}\Huge\itshape\@title\par\vspace*{\baselineskip}%
  \normalsize\upshape\@date\par%
  \normalsize\upshape\@author\par}%
  $else$%
  \vspace*{\droptitle}%
  \begin{flushleft}%
    \setstretch{1.0}\Huge\itshape\@title\par\vspace*{\baselineskip}%
    \normalsize\upshape\@date\par%
    \normalsize\upshape\@author\par%
  \end{flushleft}%
  $endif$%
}
\makeatother

\setlength{\droptitle}{4.5em} %adjust vertical offset of title to align with other headings

\title{$title$\vspace*{2\baselineskip}}
\date{
  $project$\vspace*{\baselineskip}\endgraf
  $date$\endgraf
  $if(address)$\vspace*{2\baselineskip}$endif$ %spacing between date and author, if full address shall be included
}
% add additional info to author field %
\author{
        \name\endgraf
        $if(address)${
          \department\endgraf
          \vspace*{\baselineskip}
          \institution\endgraf
          \street\endgraf
          \zipcode\,\city\endgraf
          \phone\endgraf
          \email\endgraf
          }$endif$\endgraf\vspace*{2\baselineskip}
        %\vspace{-0.6\baselineskip} % adjust spacing after author field
        }

% header & footer %
\pagestyle{fancy} % for "fancy" style
    \fancyhf{} % remove header & footer
    \fancyhfoffset[R]{\dimexpr\marginparsep+\marginparwidth\relax} % header & footer span the margin column
    \fancyfoot[R]{\scriptsize\textcolor{lightgray}\thepage} % folio on the right edge of the margin column
    \renewcommand{\headrulewidth}{0pt} % remove header decoration line

\fancypagestyle{plain}{% for "plain" style, used for titlepage and chapter beginnings
    \fancyhf{} % remove header & footer
    \fancyhfoffset[R]{\dimexpr\marginparsep+\marginparwidth\relax}%
    \fancyfoot[R]{\scriptsize\textcolor{lightgray}\thepage} % folio on the right edge of the margin column
    \renewcommand{\headrulewidth}{0pt}}

% abstract %
% left flushed abstract
\renewenvironment{abstract}
    {% remove label "Abstract"
    }
    {\par\medskip}

% table of contents %
% titles of contents & lists styled like chapter headings, or like section headings in articles
\ifdefined\chapter
\newcommand\listtitlefont{\setstretch{1.0}\Huge\itshape}
\else
\newcommand\listtitlefont{\setstretch{1.0}\Large\itshape}
\fi
\renewcommand{\cfttoctitlefont}{\listtitlefont}
% ragged-right entries, the page numbers stay flush right
\cftsetrmarg{2.55em plus 4em}

\makeatletter
\@ifclassloaded{report}{
% unböld chapter names %
\renewcommand\cftchapfont{\mdseries}
% unböld chapter folios %
\renewcommand\cftchappagefont{\mdseries\liningnumbers}
% unböld section names %
\renewcommand\cftsecfont{\mdseries}
% unböld section folios %
\renewcommand\cftsecpagefont{\mdseries\liningnumbers}
% unböld subsection names %
\renewcommand\cftsubsecfont{\mdseries}
% unböld subsection folios %
\renewcommand\cftsubsecpagefont{\mdseries\liningnumbers}
}{}
\makeatother

\makeatletter
\@ifclassloaded{book}{
% unböld chapter names %
\renewcommand\cftchapfont{\mdseries}
% unböld chapter folios %
\renewcommand\cftchappagefont{\mdseries\liningnumbers}
% unböld section names %
\renewcommand\cftsecfont{\mdseries}
% unböld section folios %
\renewcommand\cftsecpagefont{\mdseries\liningnumbers}
% unböld subsection names %
\renewcommand\cftsubsecfont{\mdseries}
% unböld subsection folios %
\renewcommand\cftsubsecpagefont{\mdseries\liningnumbers}
}{}
\makeatother

\makeatletter
\@ifclassloaded{article}{
% unböld section names %
\renewcommand\cftsecfont{\mdseries}
% unböld section folios %
\renewcommand\cftsecpagefont{\mdseries\liningnumbers}
% unböld subsection names %
\renewcommand\cftsubsecfont{\mdseries}
% unböld subsection folios %
\renewcommand\cftsubsecpagefont{\mdseries\liningnumbers}
% unböld subsubsection names %
\renewcommand\cftsubsubsecfont{\mdseries}
% unböld subsubsection folios %
\renewcommand\cftsubsubsecpagefont{\mdseries\liningnumbers}
}{}
